# Copy to .env and fill in. Never commit the real file.
OPENAI_API_KEY=sk-...

# Optional, with the defaults the service uses when they are unset.
# Any chat-completions model your account can reach; swap it without touching code.
WUMBO_MODEL=gpt-4o-mini
WUMBO_MAX_TOKENS=700
# Leave empty to omit the parameter entirely, which reasoning models require.
WUMBO_TEMPERATURE=0.3
WUMBO_REQUEST_TIMEOUT_SECONDS=30
WUMBO_RATE_LIMIT_PER_MINUTE=12
WUMBO_RATE_LIMIT_PER_HOUR=120
WUMBO_HISTORY_TURNS=12
# Comma-separated origins allowed to call the service from a browser.
WUMBO_ALLOWED_ORIGINS=http://localhost:5173,https://wumbo.brandonnlee.com
