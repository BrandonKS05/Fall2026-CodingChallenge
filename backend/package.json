{
  "name": "@trove/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Trove REST API - Express 5, TypeScript, Drizzle, Postgres",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@trove/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "@node-rs/argon2": "^2.2.1",
    "jose": "^6.2.12",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "drizzle-kit": "^0.31.10",
    "@types/pg": "^8.23.1"
  }
}
