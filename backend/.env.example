# Copy to .env and fill in. The server refuses to start if a required value is missing or invalid.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Postgres started by `docker compose up -d` (host port 5434)
DATABASE_URL=postgres://wumboo:wumboo@localhost:5434/wumboo

# Any random string of 32+ characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Free key from https://pixabay.com/api/docs/ (shown on that page once you are logged in)
PIXABAY_API_KEY=

# Browser origin allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5173

# Where saved images are stored: "local" for development, "s3" for any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Required only when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public origin of the frontend. OAuth callbacks and post-login redirects are built from it.
APP_URL=http://localhost:5173

# Optional: "Continue with Google". Leave both empty to hide the button.
# Register <APP_URL>/api/auth/google/callback as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where verification codes go. With these empty the code is written to the
# server log and returned to the client so a local sign-up can be finished;
# outside development it is only ever in the message.
# Email, through Resend (https://resend.com). Both together or neither.
RESEND_API_KEY=
EMAIL_FROM=

# Embeddings for the "You may like" feed. Empty means pictures are never given
# a vector, so recommendations fall back to what is popular. Everything else
# works without it. The same key goes in services/wumbo-ai/.env for the
# assistant.
OPENAI_API_KEY=

# The Wumbo AI service (services/wumbo-ai). /api/chat is forwarded here, so the
# browser only ever talks to this API. Defaults to the local one.
WUMBO_AI_URL=http://localhost:8000


# Set to true to create the demo account and boards on boot (idempotent). Useful on hosts without a shell.
SEED_DEMO=false
